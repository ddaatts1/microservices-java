{
  "info": {
    "_postman_id": "a8d8c3e6-d055-4b7f-a7bd-9b20f6d5f5e1",
    "name": "MSCloud Azure Container Apps",
    "description": "Postman collection for the deployed MSCloud microservices demo on Azure Container Apps. Auth is simulated with X-User-Id and X-User-Email headers; there are no login/register endpoints yet.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Gateway Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{gatewayUrl}}/api/health",
          "host": [
            "{{gatewayUrl}}"
          ],
          "path": [
            "api",
            "health"
          ]
        }
      }
    },
    {
      "name": "Current User",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-User-Id",
            "value": "{{userId}}"
          },
          {
            "key": "X-User-Email",
            "value": "{{userEmail}}"
          }
        ],
        "url": {
          "raw": "{{gatewayUrl}}/api/me",
          "host": [
            "{{gatewayUrl}}"
          ],
          "path": [
            "api",
            "me"
          ]
        }
      }
    },
    {
      "name": "List Products",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{gatewayUrl}}/api/products",
          "host": [
            "{{gatewayUrl}}"
          ],
          "path": [
            "api",
            "products"
          ]
        }
      }
    },
    {
      "name": "Get Product By Id",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{gatewayUrl}}/api/products/{{productId}}",
          "host": [
            "{{gatewayUrl}}"
          ],
          "path": [
            "api",
            "products",
            "{{productId}}"
          ]
        }
      }
    },
    {
      "name": "Create Order",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "X-User-Id",
            "value": "{{userId}}"
          },
          {
            "key": "X-User-Email",
            "value": "{{userEmail}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"productId\": \"{{productId}}\",\n  \"quantity\": 1\n}"
        },
        "url": {
          "raw": "{{gatewayUrl}}/api/orders",
          "host": [
            "{{gatewayUrl}}"
          ],
          "path": [
            "api",
            "orders"
          ]
        }
      }
    },
    {
      "name": "My Orders",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "X-User-Id",
            "value": "{{userId}}"
          },
          {
            "key": "X-User-Email",
            "value": "{{userEmail}}"
          }
        ],
        "url": {
          "raw": "{{gatewayUrl}}/api/orders/my",
          "host": [
            "{{gatewayUrl}}"
          ],
          "path": [
            "api",
            "orders",
            "my"
          ]
        }
      }
    },
    {
      "name": "Test Notification",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"to\": \"test@example.com\",\n  \"subject\": \"Azure Container Apps test\",\n  \"message\": \"Notification service is working\"\n}"
        },
        "url": {
          "raw": "{{gatewayUrl}}/api/notifications/test",
          "host": [
            "{{gatewayUrl}}"
          ],
          "path": [
            "api",
            "notifications",
            "test"
          ]
        }
      }
    }
  ],
  "event": [],
  "variable": [
    {
      "key": "gatewayUrl",
      "value": "https://gateway-service.graybay-d4e6295a.southeastasia.azurecontainerapps.io"
    },
    {
      "key": "userId",
      "value": "dev-user-001"
    },
    {
      "key": "userEmail",
      "value": "dev@example.com"
    },
    {
      "key": "productId",
      "value": "11111111-1111-1111-1111-111111111111"
    }
  ]
}
